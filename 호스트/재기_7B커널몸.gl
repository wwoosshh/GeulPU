(* 재기_7B커널 의 몸 — 머리 파일(재기_7B커널.gl 은 CUDA, 재기_7B커널V.gl 은 Vulkan)이 GPU 층(쿠다.gl · 벌칸.gl)을 먼저 포함한다.
   Vulkan 판(34단계): 커널마다의 시간으로 Vulkan 이 CUDA 보다 어디서 느린지 본다. *)
포함 "표준/입출력.gl"
포함 "표준/문자열.gl"
포함 "표준/바이트열.gl"
포함 "표준/사전.gl"
포함 "표준/수학.gl"
포함 "표준/시간.gl"
포함 "파일.gl"
포함 "해시.gl"
포함 "gguf.gl"
포함 "가중치.gl"
포함 "로프.gl"
포함 "토크나이저.gl"
포함 "엔진.gl"

상수 정수 종류수 = 11.
문자열[11] 종류이름.

[종류이름준비]는 {
    종류이름[0] = "임베딩". 종류이름[1] = "RMS". 종류이름[2] = "qkv". 종류이름[3] = "RoPEKV". 종류이름[4] = "어텐션". 종류이름[5] = "접기".
    종류이름[6] = "o". 종류이름[7] = "gate·up". 종류이름[8] = "down". 종류이름[9] = "로짓". 종류이름[10] = "가장큰번호".
}

(* 주소 w 가 종류(0 qkv · 1 o · 2 gu · 3 down)의 어느 층 가중치 안인가 — 34단계: 층마다 따로 잡은 종류(AMD 의 2 GiB 한도)도 *)
[정수 w를 정수 종류를 가중종류안인가]는 -> 참거짓 {
    정수 바탕 = 가qkv바탕.
    정수 한층 = 가qkv한층.
    종류 == 1이면 { 바탕 = 가o바탕. 한층 = 가o한층. }
    종류 == 2이면 { 바탕 = 가gu바탕. 한층 = 가gu한층. }
    종류 == 3이면 { 바탕 = 가down바탕. 한층 = 가down한층. }
    반복 (정수 l = 층시작: l < 조각층끝(): l += 1) {
        정수 a = 층가중주소(종류, 바탕, 한층, l).
        (w >= a 그리고 w < a + 한층)이면 { 반환 참. }
    }
    반환 거짓.
}

(* 띄움 k 의 종류 — 함수로, 타일 판은 셋째 매개변수(가중치의 주소)로 *)
[계획 참조 p를 정수 k를 띄움종류]는 -> 정수 {
    정수 f = p→함수[k].
    (f == (k임베딩 으로 정수) 또는 f == (k임베딩칸 으로 정수))이면 { 반환 0. }
    (f == (kRMS정수줄 으로 정수) 또는 f == (kRMS펼침 으로 정수))이면 { 반환 1. }
    (f == (kRoPEKV 으로 정수) 또는 f == (kRoPEKV칸 으로 정수))이면 { 반환 3. }
    (f == (k정수어텐션묶음 으로 정수) 또는 f == (k묶음칸 으로 정수) 또는 f == (k조각어텐션칸 으로 정수) 또는 f == (k조각어텐션넷칸 으로 정수))이면 { 반환 4. }
    (f == (k정수묶음접기 으로 정수) 또는 f == (k접기칸 으로 정수) 또는 f == (k조각접기칸 으로 정수) 또는 f == (k조각접기넓칸 으로 정수))이면 { 반환 5. }
    (f == (k가장큰번호 으로 정수) 또는 f == (k가장큰번호칸 으로 정수))이면 { 반환 10. }
    K모델이면 {                                              (* 26단계 — 임베딩_{형식} · 임베딩칸_{형식} *)
        반복 (정수 e는 0부터 6 전까지) { f == Kk표[e]이면 { 반환 0. } }
    }
    정수 w = (p→인자[p→인자시작[k] + 2] 으로 정수 참조)[0].
    K모델이면 {                                              (* 26단계 — 층의 값 · 높은 비트 [K층값, K층척) 안 *)
        반복 (정수 kk는 0부터 K종류수 전까지) {
            반복 (정수 l = 층시작: l < 조각층끝(): l += 1) {
                정수 자리 = kk * 층수 + (l - 층시작).
                (K층형식[자리] >= 0 그리고 w >= K층값[자리] 그리고 w < K층척[자리])이면 {
                    kk == 1이면 { 반환 6. }
                    kk == 2이면 { 반환 7. }
                    kk == 3이면 { 반환 8. }
                    반환 2.
                }
            }
        }
    }
    가중종류안인가(w, 0)이면 { 반환 2. }
    가중종류안인가(w, 1)이면 { 반환 6. }
    가중종류안인가(w, 2)이면 { 반환 7. }
    가중종류안인가(w, 3)이면 { 반환 8. }
    w == 머리값이면 { 반환 9. }
    파일에_쓰기(표준오류(), "띄움 %lld 의 종류를 모른다\n", k).
    1로 종료하다.
    반환 -1.
}

(* 계획 p 를 위치에서 띄움마다 이벤트 사이에 — 종류마다의 ms 를 합[종류] 에 더한다 *)
[계획 참조 p를 정수 위치를 실수 참조 합을 하나씩띄우기]는 {
    정수 m = p→m.
    p→매개[0] = 위치.
    p→매개[1] = 토큰칸.
    p→매개[2] = 생성칸.
    정수 n = p→띄움수.
    정수 참조 ev = 할당((n + 1) * 8).
    반복 (정수 i는 0부터 n + 1 전까지) { ev[i] = 새이벤트() 으로 정수. }
    맞추기().
    이벤트기록(ev[0] 으로 공허 참조).
    반복 (정수 k는 0부터 n 전까지) {
        p→고르기[k] != 0이면 {
            묶음판고르기(위치, m).
            p→함수[k] = 고른함수 으로 정수.
            p→gx[k] = 고른gx.
            p→gy[k] = 1.
            p→bx[k] = 고른bx.
        }
        띄우기(p, k).
        이벤트기록(ev[k + 1] 으로 공허 참조).
    }
    맞추기().
    반복 (정수 k2는 0부터 n 전까지) {
        정수 c = 띄움종류(p, k2).
        합[c] = 합[c] + 이벤트사이(ev[k2] 으로 공허 참조, ev[k2 + 1] 으로 공허 참조).
    }
    반복 (정수 i2는 0부터 n + 1 전까지) { 이벤트없애기(ev[i2] 으로 공허 참조). }
    해제(ev).
}

[실수 참조 v를 정수 n을 중앙값]는 -> 실수 {
    반복 (정수 i는 1부터 n 전까지) {
        정수 j = i.
        (j > 0 그리고 v[j - 1] > v[j])동안 {
            실수 t = v[j]. v[j] = v[j - 1]. v[j - 1] = t.
            j -= 1.
        }
    }
    반환 v[n / 2].
}

바이트열 참조 출력.

(* 세 번의 [종류] 합에서 종류마다 가운데 값 *)
[문자열 이름을 실수 참조 세합을 내보내기]는 {
    실수 총 = 0.0.
    실수[11] 가운데.
    반복 (정수 c는 0부터 종류수 전까지) {
        실수[3] v.
        반복 (정수 r는 0부터 3 전까지) { v[r] = 세합[r * 종류수 + c]. }
        가운데[c] = 중앙값(v, 3).
        총 = 총 + 가운데[c].
    }
    바이트열_글넣기(출력, 서식글("%s 합 %.4f", 이름, 총)).
    쓰기("%s: 합 %.3f ms —", 이름, 총).
    반복 (정수 c2는 0부터 종류수 전까지) {
        가운데[c2] > 0.0이면 {
            바이트열_글넣기(출력, 서식글(" %s %.4f", 종류이름[c2], 가운데[c2])).
            쓰기(" %s %.3f", 종류이름[c2], 가운데[c2]).
        }
    }
    바이트열_글넣기(출력, "\n").
    쓰기("\n").
}

[정수 argc를 문자열 참조 argv를 시작하기]는 -> 정수 {
    argc < 5이면 { "사용법: 재기_7B커널 <gguf> <ptx> <재기 입력> <출력>\n"을 쓰다. 반환 3. }
    종류이름준비().
    문자열 입력 = 통째읽기(argv[3]).
    정수 o = 0.
    정수 pc = 읽기64(입력, o). o += 8 + pc * 8.
    정수 pl = 읽기64(입력, o). o += 8.
    정수 참조 긴 = (입력 + o) 으로 정수 참조.
    쿠다열기().
    GGUF 참조 g = GGUF열기(argv[1]).
    엔진만들기(g, argv[2], 1024, 8448, 1).
    문자열 판파일 = 판고정인자(argc, argv, 5).          (* 33단계 — [--판 <파일>]: 판을 파일로 고정(재기_7B 와 같은 파일) *)
    참거짓 판시간 = 거짓.                               (* 34단계 — [--판시간]: 판을 고르며 잰 후보마다의 시간을 찍는다(--판 과 함께 쓰지 않는다) *)
    정수 길이하나 = 0.                                  (* 34단계 — [--길이 N]: 프롬프트를 N 행 하나만(1024 이하 — 짧은 프롬프트) *)
    반복 (정수 a = 5: a < argc: a += 1) {
        문자열_같은가(argv[a], "--판시간")이면 { 판시간 = 참. }
        (문자열_같은가(argv[a], "--길이") 그리고 a + 1 < argc)이면 { 길이하나 = 정수로_변환(argv[a + 1]). }
    }
    (길이하나 < 0 또는 길이하나 > 1024)이면 { "--길이 는 1 … 1024\n"을 쓰다. 반환 3. }
    판시간이면 { 재기기록 = 정수목록_만들기(). }
    판파일 == 없음이면 { 판미리고르기(). }
    아니면 아닌 판고정고르기(판파일)이면 { 쓰기("판 파일 %s 의 판을 이 모듈에서 쓸 수 없다\n", 판파일). 반환 1. }
    판시간이면 {
        반복 (정수 k는 0부터 정수목록_길이(재기기록) / 4 전까지) {
            쓰기("판시간 %lld %lld %lld %.4f\n", 정수목록_값(재기기록, 4 * k), 정수목록_값(재기기록, 4 * k + 1), 정수목록_값(재기기록, 4 * k + 2),
                 비트실수값(정수목록_값(재기기록, 4 * k + 3))).
        }
    }
    출력 = 바이트열_만들기().
    실수 참조 세합 = 할당(3 * 종류수 * 8).
    계획 참조 p1024 = 계획짓기(1024).
    (* 프롬프트 2048 · 8192 — 덩이 1024. --길이 N 이면 N 행 하나만 *)
    길이하나 > 0이면 {
        계획 참조 pN = 계획짓기(길이하나).
        반복 (정수 r0는 0부터 3 전까지) {
            반복 (정수 z0는 0부터 종류수 전까지) { 세합[r0 * 종류수 + z0] = 0.0. }
            토큰넣기(긴, 길이하나).
            하나씩띄우기(pN, 0, 세합 + r0 * 종류수).
        }
        내보내기(서식글("프롬프트 %lld", 길이하나), 세합).
    }
    반복 (정수 c는 0부터 2 전까지) {
        길이하나 > 0이면 { 탈출. }
        정수 n = 2048.
        c == 1이면 { n = 8192. }
        반복 (정수 r는 0부터 3 전까지) {
            반복 (정수 z는 0부터 종류수 전까지) { 세합[r * 종류수 + z] = 0.0. }
            반복 (정수 a = 0: a < n: a += 1024) {
                토큰넣기(긴 + a, 1024).
                하나씩띄우기(p1024, a, 세합 + r * 종류수).
            }
        }
        내보내기(서식글("프롬프트 %lld", n), 세합).
    }
    (* 생성 — 문맥 2048 · 8192 를 채우고 토큰 하나 *)
    생성계획 == 없음이면 { 생성계획 = 생성계획짓기(). }
    반복 (정수 c2는 0부터 2 전까지) {
        정수 n2 = 2048.
        c2 == 1이면 { n2 = 8192. }
        반복 (정수 a2 = 0: a2 < n2: a2 += 1024) {
            토큰넣기(긴 + a2, 1024).
            계산(1024, a2).
        }
        맞추기().
        반복 (정수 r2는 0부터 3 전까지) {
            반복 (정수 z2는 0부터 종류수 전까지) { 세합[r2 * 종류수 + z2] = 0.0. }
            큰생성준비(긴[0], n2).
            하나씩띄우기(생성계획, 0, 세합 + r2 * 종류수).
        }
        내보내기(서식글("생성 문맥 %lld", n2), 세합).
    }
    통째쓰기(argv[4], 바이트열_자료(출력), 바이트열_길이(출력)).
    쿠다닫기().
    반환 0.
}
