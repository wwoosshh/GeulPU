(* 18b 시험의 글 쪽: GGUF 를 읽어 가중치를 GPU 에 올리고, 올린 버퍼마다 SHA-256 (장치에서 내려받아) 을 적는다.
     시험_준비 <gguf> *)
포함 "표준/입출력.gl"
포함 "표준/문자열.gl"
포함 "표준/사전.gl"
포함 "표준/시간.gl"
포함 "쿠다.gl"
포함 "파일.gl"
포함 "해시.gl"
포함 "gguf.gl"
포함 "가중치.gl"

[정수 argc를 문자열 참조 argv를 시작하기]는 -> 정수 {
    argc < 2이면 { "사용법: 시험_준비 <gguf>\n"을 쓰다. 반환 3. }
    실수 t0 = 정밀시각_밀리초().
    쿠다열기().
    GGUF 참조 g = GGUF열기(argv[1]).
    실수 t1 = 정밀시각_밀리초().
    g를 가중치올리기하다.
    맞추기().
    실수 t2 = 정밀시각_밀리초().
    쓰기("읽기 %.1f ms, 깔고 올리기 %.1f ms\n", t1 - t0, t2 - t1).
    쓰기("설정 층 %lld 너비 %lld 머리 %lld KV머리 %lld 확장폭 %lld 어휘 %lld 위치 %lld 로프밑 %.1f 머리같음 %lld\n", 층수, 너비, 머리수, KV머리수, 확장폭, 어휘수, 모델위치, 로프밑, 머리같음 으로 정수).
    쓰기("qkv %s\n", 장치해시(가qkv바탕, 층수 * 가qkv한층)).
    쓰기("o %s\n", 장치해시(가o바탕, 층수 * 가o한층)).
    쓰기("gu %s\n", 장치해시(가gu바탕, 층수 * 가gu한층)).
    쓰기("down %s\n", 장치해시(가down바탕, 층수 * 가down한층)).
    쓰기("qkv치우침 %s\n", 장치해시(가치우침바탕, 층수 * QKV폭 * 4)).
    쓰기("n1 %s\n", 장치해시(가n1바탕, 층수 * 너비 * 4)).
    쓰기("n2 %s\n", 장치해시(가n2바탕, 층수 * 너비 * 4)).
    쓰기("낱말 %s\n", 장치해시(낱말값, Q8바이트(너비, 어휘수))).
    쓰기("머리 %s\n", 장치해시(머리값, Q8바이트(너비, 어휘수))).
    쓰기("출력정규 %s\n", 장치해시(출력정규, 너비 * 4)).
    쿠다닫기().
    반환 0.
}
