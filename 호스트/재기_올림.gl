(* 실행기의 올림(모델을 올려 대화를 받을 수 있을 때까지)을 잰다.
     재기_올림 <gguf> <ptx> [최대길이 8192] [최대행 2048] [차례|겹침]
   차례: 한 스레드로 단계마다 나누어(엔진만들기 안도). 겹침: 실행기와 같은 겹쳐올리기(일꾼.gl) — '프롬프트까지'(실행기가 '올림' 으로
   보이는 값)와 남은 일꾼(판 고르기 · 토크나이저 · 사상 풀기)이 끝난 때를 적는다. *)
포함 "표준/입출력.gl"
포함 "표준/문자열.gl"
포함 "표준/바이트열.gl"
포함 "표준/사전.gl"
포함 "표준/수학.gl"
포함 "표준/시간.gl"
포함 "쿠다.gl"
포함 "파일.gl"
포함 "해시.gl"
포함 "gguf.gl"
포함 "가중치.gl"
포함 "로프.gl"
포함 "토크나이저.gl"
포함 "엔진.gl"
포함 "대화.gl"
포함 "일꾼.gl"

[정수 argc를 문자열 참조 argv를 시작하기]는 -> 정수 {
    argc < 3이면 { "사용법: 재기_올림 <gguf> <ptx> [최대길이] [최대행] [차례|겹침]\n"을 쓰다. 반환 3. }
    정수 길이 = 8192.
    정수 행 = 2048.
    argc > 3이면 { 길이 = 정수로_변환(argv[3]). }
    argc > 4이면 { 행 = 정수로_변환(argv[4]). }
    참거짓 겹침 = argc > 5 그리고 문자열_같은가(argv[5], "겹침").
    실수 t0 = 정밀시각_밀리초().
    겹침이면 {
        공허 참조 판핸들 = 겹쳐올리기(argv[1], argv[2], 행, 길이, 1).
        실수 t1 = 정밀시각_밀리초().
        일꾼기다림(판핸들).
        실수 t2 = 정밀시각_밀리초().
        쓰기("깔기 %.1f ms · 머리 비교 %.1f ms (이 스레드, 쿠다 · 토크나이저 · RoPE 일꾼과 겹쳐)\n", 깔기ms, 머리비교ms).
        올림시각수 >= 5이면 {
            쓰기("엔진만들기 %.1f ms: 올리기 %.1f · 모듈(일꾼이 이미) %.1f · RoPE 올리기 %.1f · 버퍼 %.1f\n", 올림시각[4] - 올림시각[0],
                올림시각[1] - 올림시각[0], 올림시각[2] - 올림시각[1], 올림시각[3] - 올림시각[2], 올림시각[4] - 올림시각[3]).
            쓰기("엔진만들기 시작 %.1f ms\n", 올림시각[0] - t0).
        }
        쓰기("프롬프트까지 %.1f ms\n", t1 - t0).
        쓰기("남은 일꾼 끝 %.1f ms (프롬프트 뒤 %.1f ms)\n", t2 - t0, t2 - t1).
        쿠다닫기().
        반환 0.
    }
    쿠다열기().
    실수 t1b = 정밀시각_밀리초().
    GGUF 참조 g = GGUF열기(argv[1]).
    실수 t2b = 정밀시각_밀리초().
    g를 토크나이저열기하다.
    실수 t3b = 정밀시각_밀리초().
    엔진만들기(g, argv[2], 행, 길이, 1).
    실수 t4b = 정밀시각_밀리초().
    g를 GGUF닫기하다.
    판미리고르기().
    실수 t5b = 정밀시각_밀리초().
    쓰기("쿠다열기 %.1f ms\n", t1b - t0).
    쓰기("GGUF열기 %.1f ms\n", t2b - t1b).
    쓰기("토크나이저열기 %.1f ms\n", t3b - t2b).
    쓰기("엔진만들기 %.1f ms\n", t4b - t3b).
    올림시각수 >= 5이면 {
        쓰기("  가중치 %.1f ms (깔기 %.1f · 머리 비교 %.1f · 올리기 %.1f)\n", 올림시각[1] - 올림시각[0], 깔기ms, 머리비교ms, 올리기ms).
        쓰기("  판표 · PTX 읽기 · 모듈 · 함수얻기 %.1f ms\n", 올림시각[2] - 올림시각[1]).
        쓰기("  RoPE 표 · 올리기 %.1f ms\n", 올림시각[3] - 올림시각[2]).
        쓰기("  버퍼 %.1f ms\n", 올림시각[4] - 올림시각[3]).
    }
    쓰기("판미리고르기 %.1f ms\n", t5b - t4b).
    쓰기("모두 %.1f ms\n", t5b - t0).
    쿠다닫기().
    반환 0.
}
