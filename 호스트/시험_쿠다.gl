포함 "표준/입출력.gl"
포함 "표준/문자열.gl"
포함 "쿠다.gl"

[정수 argc를 문자열 참조 argv를 시작하기]는 -> 정수 {
    쿠다열기().
    쓰기("GPU: %s, SM %lld\n", 장치이름(), 장치속성(16)).
    정수 p = 장치할당(1024).
    정수[4] 값.
    값[0] = 7. 값[1] = 8. 값[2] = 9. 값[3] = 10.
    올리기(p, 값, 32).
    정수[4] 받음.
    내리기(받음, p, 32).
    쓰기("%lld %lld %lld %lld\n", 받음[0], 받음[1], 받음[2], 받음[3]).
    쿠다닫기().
    반환 0.
}
